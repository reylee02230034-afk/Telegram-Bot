FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache openssl python3 make g++

FROM base AS deps
COPY package.json package-lock.json ./
COPY prisma ./prisma/
COPY apps/web/package.json ./apps/web/
COPY apps/bot/package.json ./apps/bot/
RUN npm ci
RUN npx prisma generate

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/prisma ./prisma
COPY . .
WORKDIR /app/apps/bot
RUN npx tsc

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 bot && adduser --system --uid 1001 bot

COPY --from=builder --chown=bot:bot /app/prisma ./prisma
COPY --from=builder --chown=bot:bot /app/node_modules ./node_modules
COPY --from=builder --chown=bot:bot /app/apps/bot/dist ./apps/bot/dist
COPY --from=builder --chown=bot:bot /app/apps/bot/package.json ./apps/bot/package.json
COPY --from=builder --chown=bot:bot /app/apps/bot/node_modules ./apps/bot/node_modules

USER bot
WORKDIR /app

CMD ["sh", "-c", "npx prisma migrate deploy && node apps/bot/dist/index.js"]
